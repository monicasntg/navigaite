# Copy this file to .env. Never share or commit .env.
LLM_API_KEY=REPLACE_WITH_YOUR_API_KEY

# NVIDIA's hosted API base, not the full /chat/completions URL.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Use an exact model ID that your account can access. No model is assumed working.
LLM_MODEL=REPLACE_WITH_YOUR_ACCESSIBLE_MODEL_ID

# Use the documented limit for that exact hosted endpoint/model, not a guess.
LLM_CONTEXT_TOKENS=REPLACE_WITH_VERIFIED_CONTEXT_LIMIT

LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=30
